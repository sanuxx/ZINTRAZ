# Production server settings. Copy to .env.production.local (or set them in your process manager) on the
# server; never commit the real values. The GitHub Pages preview needs none of these.

# Public address of the site, used in emails and the sitemap. No trailing slash.
SITE_URL=https://zintraz.com

# ── Blueprint submissions (/system-builder → /api/blueprints) ──
# Where submissions are saved, one JSON file each. Back this folder up.
BLUEPRINT_DIR=/var/lib/zintraz/blueprints

# SMTP for emailing new submissions to the team and a confirmation to the client.
# Leave SMTP_HOST empty to only save submissions (they still appear on the admin page).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ZINTRAZ website <no-reply@zintraz.com>"
MAIL_TO=sales@zintraz.com

# ── Admin review pages (/admin/blueprints) ──
# The password your team signs in with, and a long random secret for signing sessions (32+ characters),
# e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SECRET=
